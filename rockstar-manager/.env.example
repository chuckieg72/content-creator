# Put real credentials only in the runtime's private secret manager or a local ignored .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AGENT_MAX_OUTPUT_TOKENS=3000

# Separate paid video capability. This key is not an agent-wide connection.
FAL_KEY=

# Other provider credentials are placeholders; their execution adapters are not yet implemented.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
