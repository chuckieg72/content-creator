# Keep real values only in the backend's private secret manager or local ignored .env.
# This key powers text work; ChatGPT subscriptions do not provide API credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AGENT_MAX_OUTPUT_TOKENS=3000

# Video generation is a separate capability and may use paid fal.ai credits.
FAL_KEY=
# Initial fal.ai test ceiling recorded for TMS; the runtime must enforce this before generation.
FAL_MONTHLY_BUDGET_USD=10
FAL_JOB_BUDGET_USD=2

# Optional direct APIs; provider execution must be implemented and configured before use.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
